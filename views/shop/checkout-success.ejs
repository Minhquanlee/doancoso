<h2>Thanh toán thành công</h2>
<p>Đơn hàng #<%= orderId %> đã được tạo. Tổng: <%= total.toLocaleString() %> VND</p>

<% const appliedDiscountSummary = (typeof discountSummary !== 'undefined' && discountSummary) ? discountSummary : null; %>
<% if (appliedDiscountSummary && appliedDiscountSummary.discountAmount > 0 && appliedDiscountSummary.appliedDiscount) { %>
	<p>Mã giảm giá đã áp dụng: <strong><%= appliedDiscountSummary.appliedDiscount.code %></strong> — giảm <strong><%= appliedDiscountSummary.discountAmount.toLocaleString() %> VND</strong></p>
<% } %>
<a href="/">Quay về cửa hàng</a>
