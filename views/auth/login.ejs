<div class="auth-card">
  <h2>Đăng nhập</h2>
  <% if (typeof notice !== 'undefined' && notice) { %>
    <div class="auth-notice-banner"><%= notice %></div>
  <% } %>
  <form method="post" action="/login" class="auth-form">
    <input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? next : '/' %>" />
    <input type="hidden" name="notice" value="<%= typeof notice !== 'undefined' ? notice : '' %>" />
    <label>Email
      <input type="email" name="email" required />
    </label>
    <label>Mật khẩu
      <input type="password" name="password" required />
    </label>
    <div class="auth-actions">
      <button type="submit" class="btn">Đăng nhập</button>
      <a href="/register" class="link-btn" data-no-transition="true">Đăng ký</a>
    </div>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="text-muted" style="color:#b91c1c;margin-top:12px"><%= error %></div>
    <% } %>
  </form>
</div>
